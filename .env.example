# ─────────────────────────────────────────────
#  RupeeTracker — Local Development Environment
#  Copy this to .env and fill in your real values
#  NEVER commit .env to git (it's in .gitignore)
# ─────────────────────────────────────────────

# ── AI Configuration (OpenRouter) ──────────────
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_KEY

# Free model to use. See available free models at:
# https://openrouter.ai/models?order=pricing&supported_parameters=free
AI_MODEL=google/gemini-2.0-flash-exp:free

# ── Application Configuration ───────────────────
PORT=8080
# Your deployed Railway URL (or http://localhost:8080 for local dev)
APP_URL=https://your-app-name.up.railway.app

# ── Finnhub (Stock Prices) ──────────────────────
# Get a free key at: https://finnhub.io/register
# Used server-side — never sent to browser
FINNHUB_API_KEY=REPLACE_WITH_YOUR_FINNHUB_KEY

# ── Broker Integration (All Optional) ──────────
# Only fill in the broker(s) you use

# HDFC Securities — https://developer.hdfcsec.com
HDFC_API_KEY=
HDFC_API_SECRET=

# Zerodha Kite — https://kite.trade (create app)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# Groww — https://groww.in (developer API, beta)
GROWW_API_KEY=
GROWW_API_SECRET=

# Angel One SmartAPI — https://smartapi.angelone.in
ANGEL_API_KEY=
ANGEL_CLIENT_ID=

# Upstox v2 — https://account.upstox.com/developer/apps
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
